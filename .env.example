# Variable NAMES only. Never commit real values.

# yt-serve: bearer token (16+ characters). Required to listen on anything but 127.0.0.1.
YIE_API_TOKEN=

# yt-handoff / yt-serve: HMAC key for signing approvals (32+ characters). Share it ONLY with
# the system that executes production instructions (e.g. CineForge) so it can verify them.
YIE_APPROVAL_KEY=

# --- read-only YouTube connector (yt-youtube) ---
# Prefer injecting these from a secrets manager; a local .env file is ignored by git.

# Public channel/video metadata (YouTube Data API v3). Restrict the key to that API in Google Cloud.
YOUTUBE_API_KEY=

# Owner data (YouTube Analytics API) - read-only scopes only:
#   youtube.readonly, yt-analytics.readonly
# Either a short-lived access token...
YT_OAUTH_ACCESS_TOKEN=
# ...or a refresh token plus the OAuth client it was issued to.
YT_OAUTH_REFRESH_TOKEN=
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
# ...or point at the file written by `yt-youtube login --save PATH` (must be mode 600,
# outside any git repository) instead of setting YT_OAUTH_REFRESH_TOKEN.
YT_OAUTH_TOKEN_FILE=

# --- waitlist (Vercel project settings, not this file; see docs/WAITLIST.md) ---
# WAITLIST_ENABLED=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# 32+ random characters; signs anti-spam challenges and confirmation links.
# WAITLIST_SECRET=
# Confirmation emails (double opt-in). Sending-only key.
# RESEND_API_KEY=
# WAITLIST_FROM_EMAIL=
# Optional: WAITLIST_POW_BITS (default 17), WAITLIST_ALLOWED_ORIGINS, WAITLIST_SINGLE_OPT_IN
