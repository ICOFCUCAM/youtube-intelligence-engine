# Variable NAMES for the read-only YouTube connector (yt-youtube). Never commit real values.
# Prefer injecting these from a secrets manager; a local .env file is ignored by git.

# Public channel/video metadata (YouTube Data API v3). Restrict the key to that API in Google Cloud.
YOUTUBE_API_KEY=

# Owner data (YouTube Analytics API) - read-only scopes only:
#   youtube.readonly, yt-analytics.readonly
# Either a short-lived access token...
YT_OAUTH_ACCESS_TOKEN=
# ...or a refresh token plus the OAuth client it was issued to.
YT_OAUTH_REFRESH_TOKEN=
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
